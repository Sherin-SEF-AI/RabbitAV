    <string name="onboarding_title">RabbitAV सेट करें</string>
    <string name="onboarding_intro">RabbitAV आगे की सड़क देखता है और हर गड्ढा याद रखता है। काम करने के लिए कुछ अनुमतियाँ चाहिए — सब कुछ आपके फ़ोन पर ही रहता है।</string>
    <string name="perm_notifications_title">सूचनाएँ</string>
    <string name="perm_notifications_body">ऐप बैकग्राउंड में होने पर ड्राइव सत्र की स्थिति दिखाता है।</string>
    <string name="perm_camera_title">कैमरा</string>
    <string name="perm_camera_body">आगे वाहन, लोग और जानवर पहचानता है। वीडियो फ़ोन पर ही लाइव प्रोसेस होता है — कभी सेव या अपलोड नहीं होता।</string>
    <string name="perm_location_title">लोकेशन</string>
    <string name="perm_location_body">आपकी गति मापता है और खतरों को नक्शे पर दर्ज करता है। लोकेशन डिवाइस पर ही रहती है, जब तक आप अनाम सिंक चालू न करें।</string>
