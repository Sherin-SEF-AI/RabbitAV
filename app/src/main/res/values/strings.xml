    <!-- Calibration wizard -->
    <string name="calib_title">Mount calibration</string>
    <string name="calib_step1_title">1 · Mount &amp; vehicle</string>
    <string name="calib_step1_body">Fix the phone on the windshield, camera facing the road, screen toward you. Pick your vehicle so RabbitAV knows the camera height.</string>
