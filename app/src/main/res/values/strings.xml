    <!-- Onboarding / permissions -->
    <string name="onboarding_title">Set up RabbitAV</string>
    <string name="onboarding_intro">RabbitAV watches the road ahead and remembers every pothole. It needs a few permissions to do its job — everything stays on your phone.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">Shows the drive session status while the app is in the background.</string>
    <string name="perm_camera_title">Camera</string>
    <string name="perm_camera_body">Detects vehicles, people and animals ahead. Video is processed live on the phone and never stored or uploaded.</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_body">Measures your speed and pins hazards to the map. Locations stay on the device unless you enable anonymous sync.</string>
